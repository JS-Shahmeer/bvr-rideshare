# Copy to .env and fill in to run the app against Supabase (live mode).
# Leave empty to run on demo data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: street map tiles drawn over the offline basemap, e.g.
# https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
EXPO_PUBLIC_MAP_TILE_URL=
